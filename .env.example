# =====================================================================
#  SPECACT — cấu hình / configuration
#  Sao chép thành `.env` rồi chỉnh sửa. Copy to `.env` and edit.
#  Mọi biến VITE_* có thể đổi lúc chạy Docker mà KHÔNG cần build lại
#  (trừ VITE_BASE_PATH). All VITE_* vars can be changed at container
#  start without rebuilding (except VITE_BASE_PATH).
#  KHÔNG đặt Google client secret ở đây — người dùng tự nhập trên
#  trình duyệt và nó chỉ nằm (mã hóa) trên thiết bị của họ.
#  NEVER put a Google client secret here — each user enters their own
#  in the browser and it is only stored (encrypted) on their device.
# =====================================================================

# ---- Docker / server ------------------------------------------------
# Cổng công khai của container / host port published by docker compose
SPECACT_PORT=8088

# ---- Ứng dụng / application ----------------------------------------
VITE_APP_NAME=SPECACT
# Đường dẫn gốc khi host ở thư mục con (ví dụ /specact/). Build-time only.
VITE_BASE_PATH=/
# Ngôn ngữ mặc định: vi en zh ja ko ru fr de es th id hi ar tr
VITE_DEFAULT_LANG=vi
# true = lần đầu mở, dùng ngôn ngữ của trình duyệt nếu có bản dịch; false = luôn dùng VITE_DEFAULT_LANG
VITE_DETECT_LANG=true
# Giao diện mặc định: system | light | dark
VITE_DEFAULT_THEME=system
# Bật chế độ dùng thử (dữ liệu mẫu, không cần Google) / enable demo mode
VITE_ENABLE_DEMO=true

# Email liên hệ hiển thị ở trang Điều khoản/Quyền riêng tư (người vận hành điền; để trống = ẩn)
VITE_LEGAL_CONTACT=

# ---- Google Drive ---------------------------------------------------
VITE_DRIVE_ROOT_FOLDER=SPECACT
VITE_DRIVE_POSTS_FOLDER=posts
# Phạm vi OAuth. Cần quyền "drive" đầy đủ để mở bài người khác chia sẻ
# (drive.file chỉ thấy file do chính OAuth client này tạo).
VITE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive
# Để trống = tự dùng địa chỉ của trang. Phải trùng "Authorized redirect URI".
VITE_OAUTH_REDIRECT_URI=
# trash = chuyển vào thùng rác Drive (khôi phục được) | permanent = xóa vĩnh viễn
VITE_DELETE_MODE=trash
# Gửi email thông báo của Google khi chia sẻ / send Google's share e-mail
VITE_NOTIFY_EMAIL=false
# Tự đồng bộ chỉ mục "được chia sẻ với tôi" mỗi N giây (0 = tắt)
VITE_SYNC_INTERVAL_SECONDS=180

# ---- Bảo mật cục bộ / local security -------------------------------
VITE_PIN_LENGTH=6
VITE_PBKDF2_ITERATIONS=600000
# Sai quá số lần này thì xóa kho khóa cục bộ trên thiết bị
VITE_PIN_MAX_ATTEMPTS=10
# Tự khóa sau N phút không thao tác (0 = không tự khóa)
VITE_AUTO_LOCK_MINUTES=5
# Số vòng PBKDF2 cho mật khẩu bài viết
VITE_POST_KDF_ITERATIONS=310000

# ---- Ảnh / media ----------------------------------------------------
VITE_MAX_IMAGES_PER_POST=10
VITE_MAX_IMAGE_MB=25
VITE_IMAGE_MAX_DIMENSION=2048
VITE_IMAGE_QUALITY=0.86
VITE_THUMB_DIMENSION=480
